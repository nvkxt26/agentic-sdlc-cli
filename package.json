{
  "name": "@nvkxt26/agentic-workflow-cli",
  "version": "1.4.1",
  "description": "Installable agentic SDLC workflow CLI providing GitHub Copilot skills, persona agents, and an orchestrator that communicate via TOON/caveman format",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "agentic",
    "copilot",
    "sdlc",
    "cli",
    "toon"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "type": "module",
  "bin": {
    "agentic-workflow": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "templates"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
