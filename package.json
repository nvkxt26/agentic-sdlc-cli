{
  "name": "@nvkxt26/agentic-sdlc-cli",
  "version": "2.1.0",
  "description": "Installable agentic SDLC workflow CLI for GitHub Copilot, Claude Code and OpenCode — persona agents, deterministic skills, an orchestrator, cross-repo workspaces and epic planning that communicate via TOON/caveman format",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "agentic",
    "copilot",
    "sdlc",
    "cli",
    "toon"
  ],
  "author": "",
  "license": "GPL-3.0-only",
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "type": "module",
  "bin": {
    "agentic-sdlc": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "templates"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
